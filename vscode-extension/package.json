{
  "name": "vsjjonku-workspace-bridge",
  "displayName": "VS쫀쿠 Workspace Bridge",
  "description": "Local policy-controlled bridge between VS쫀쿠 and a VS Code Workspace.",
  "version": "0.1.8",
  "publisher": "vsjjonku",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "package.json",
    "README.md"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "VS쫀쿠",
      "properties": {
        "vsjjonku.bridgePort": {
          "type": "number",
          "default": 38991,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Loopback-only Bridge RPC port."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.137.0",
    "typescript": "^5.7.0"
  }
}
